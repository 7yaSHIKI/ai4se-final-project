# 环境变量配置模板
# 复制此文件为 .env 并填入真实值

# OpenAI API 配置（必需）
OPENAI_API_KEY=your_api_key_here

# 数据库配置（可选，默认使用 SQLite）
DATABASE_URL=sqlite:///./data/rss_aggregator.db

# 日志级别（可选，默认 INFO）
# 可选值：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 应用端口（可选，默认 8000）
PORT=8000

# RSS 抓取配置（可选）
RSS_FETCH_INTERVAL=3600  # 抓取间隔（秒），默认 1 小时
RSS_TIMEOUT=10  # RSS 请求超时（秒），默认 10 秒

# 数据保留配置（可选）
ARTICLE_RETENTION_DAYS=7  # 文章保留天数，默认 7 天
